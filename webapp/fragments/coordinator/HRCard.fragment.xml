<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <VBox
        id="hrKpiSection"
        class="jhahSection"
        renderType="Bare"
        visible="{dashboard>/access/hr}">

        <Title
            id="hrKpiTitle"
            text=""
            level="H5"
            class="jhahSectionTitle" />

        <HBox
            id="hrKpiRow"
            class="jhahKpiRow"
            renderType="Bare"
            wrap="Wrap">

            <!-- ================================================= -->
            <!-- TOTAL REQUESTS -->
            <!-- ================================================= -->

            <f:Card
                id="cardTotalRequests"
                class="jhahKpiCard jhahAccentBlue jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="totalRequestsInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="totalRequestsIcon"
                            src="sap-icon://request"
                            class="jhahKpiIcon jhahKpiIconBlue" />

                        <VBox
                            id="totalRequestsTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="totalRequestsLabel"
                                text="Total Requests"
                                class="jhahKpiTitle" />

                            <Text
                                id="totalRequestsValue"
                                text="{dashboard>/idCard/hrKpi/totalRequestsRaised}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- NEW HIRE REQUESTS -->
            <!-- ================================================= -->

            <f:Card
                id="cardNewHireRequests"
                class="jhahKpiCard jhahAccentGreen jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="newHireInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="newHireIcon"
                            src="sap-icon://employee"
                            class="jhahKpiIcon jhahKpiIconGreen" />

                        <VBox
                            id="newHireTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="newHireLabel"
                                text="New Hire Requests"
                                class="jhahKpiTitle" />

                            <Text
                                id="newHireValue"
                                text="{dashboard>/idCard/hrKpi/newHireRequestCount}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- PENDING PRINTING -->
            <!-- ================================================= -->

            <f:Card
                id="cardPendingPrinting"
                class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="pendingPrintingInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="pendingPrintingIcon"
                            src="sap-icon://print"
                            class="jhahKpiIcon jhahKpiIconOrange" />

                        <VBox
                            id="pendingPrintingTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="pendingPrintingLabel"
                                text="Pending Printing"
                                class="jhahKpiTitle" />

                            <Text
                                id="pendingPrintingValue"
                                text="{dashboard>/idCard/hrKpi/pendingPrintingCount}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- PENDING APPROVAL -->
            <!-- ================================================= -->

            <f:Card
                id="cardPendingApproval"
                class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="pendingApprovalInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="pendingApprovalIcon"
                            src="sap-icon://pending"
                            class="jhahKpiIcon jhahKpiIconOrange" />

                        <VBox
                            id="pendingApprovalTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="pendingApprovalLabel"
                                text="Pending Approval"
                                class="jhahKpiTitle" />

                            <Text
                                id="pendingApprovalValue"
                                text="{dashboard>/idCard/hrKpi/pendingApprovalCount}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- APPROVED / REJECTED -->
            <!-- ================================================= -->

            <f:Card
                id="cardApprovedRejected"
                class="jhahKpiCard jhahAccentGreen jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="approvedRejectedInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="approvedRejectedIcon"
                            src="sap-icon://accept"
                            class="jhahKpiIcon jhahKpiIconGreen" />

                        <VBox
                            id="approvedRejectedTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="approvedRejectedLabel"
                                text="Approved / Rejected"
                                class="jhahKpiTitle" />

                            <Text
                                id="approvedRejectedValue"
                                text="{= ${dashboard>/idCard/hrKpi/approvedCount} + ' / ' + ${dashboard>/idCard/hrKpi/rejectedCount} }"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>

        </HBox>

    </VBox>

</core:FragmentDefinition>