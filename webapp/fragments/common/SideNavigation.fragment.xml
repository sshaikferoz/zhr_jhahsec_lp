<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <VBox class="jhahSideNavWrap" renderType="Bare" height="100%" justifyContent="SpaceBetween">
        <VBox renderType="Bare">
            <VBox class="jhahBrandArea" renderType="Bare" justifyContent="Start">
                <HBox class="jhahBrand" alignItems="Center">
                    <Image
                        src="{dashboard>/logoUrl}"
                        alt="JHAH Logo"
                        densityAware="false"
                        width="220px"
                    />
                </HBox>
            </VBox>
            <List
                items="{dashboard>/navItems}"
                mode="SingleSelectMaster"
                showSeparators="None"
                backgroundDesign="Transparent"
                class="jhahNavList"
                selectionChange=".onNavItemSelect"
            >
                <CustomListItem
                    selected="{dashboard>selected}"
                    class="jhahNavItem"
                >
                    <customData>
                        <core:CustomData key="navKey" value="{dashboard>key}" />
                    </customData>
                    <HBox alignItems="Center" class="jhahNavItemInner" renderType="Bare">
                        <core:Icon src="{dashboard>icon}" class="jhahNavItemIcon" />
                        <Text text="{dashboard>title}" class="jhahNavItemText" />
                    </HBox>
                </CustomListItem>
            </List>
        </VBox>
        <VBox class="jhahSideNavFooter" renderType="Bare">
            <!-- Pattern banner sits visibly between nav items and profile card -->
            <Image src="{dashboard>/patternUrl}" alt="" densityAware="false" class="jhahFooterPattern" />

            <VBox class="jhahSidebarUserCard" renderType="Bare">

                <!-- Avatar + Name + Role -->
                <HBox alignItems="Center" class="jhahUserCardHeader" renderType="Bare">
                    <Avatar
                        displayShape="Circle"
                        initials="{dashboard>/user/initials}"
                        displaySize="S"
                        backgroundColor="Accent6"
                        class="jhahUserAvatar"
                    />
                    <VBox renderType="Bare" class="jhahUserCardNameWrap">
                        <Text text="{dashboard>/user/name}" class="jhahSidebarName" />
                        <Text text="{dashboard>/user/role}" class="jhahSidebarRole jhahSidebarSub" />
                    </VBox>
                </HBox>

                <VBox class="jhahUserCardDivider" renderType="Bare" />

                <!-- Field rows in same sequence as ObjectHeader -->
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow" renderType="Bare">
                    <Label text="JHAH ID" class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/id}" class="jhahSidebarValue jhahUserCardVal" />
                </HBox>
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow" renderType="Bare">
                    <Label text="Login ID" class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/loginId}" class="jhahSidebarValue jhahUserCardVal" />
                </HBox>
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow" renderType="Bare">
                    <Label text="Badge No." class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/badgeNo}" class="jhahSidebarValue jhahUserCardVal" />
                </HBox>
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow" renderType="Bare">
                    <Label text="Gov. ID" class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/governmentId}" class="jhahSidebarValue jhahUserCardVal" />
                </HBox>
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow" renderType="Bare">
                    <Label text="Organization" class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/department}" class="jhahSidebarValue jhahUserCardVal" />
                </HBox>
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow" renderType="Bare">
                    <Label text="Position" class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/position}" class="jhahSidebarValue jhahUserCardVal" />
                </HBox>
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow" renderType="Bare">
                    <Label text="Date of Birth" class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/dob}" class="jhahSidebarValue jhahUserCardVal" />
                </HBox>
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow" renderType="Bare">
                    <Label text="Blood Group" class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/bloodGroup}" class="jhahSidebarValue jhahUserCardVal" />
                </HBox>
                <HBox justifyContent="SpaceBetween" class="jhahUserCardRow jhahUserCardRowLast" renderType="Bare">
                    <Label text="E-Mail" class="jhahSidebarLabel jhahUserCardLabel" />
                    <Text text="{dashboard>/user/email}" class="jhahSidebarValue jhahUserCardVal jhahUserCardEmail" />
                </HBox>

            </VBox>
        </VBox>
    </VBox>
</core:FragmentDefinition>
