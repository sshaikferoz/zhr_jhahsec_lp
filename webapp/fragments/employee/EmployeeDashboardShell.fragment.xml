<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <HBox
        class="jhahDashboardGrid"
        renderType="Bare"
        wrap="Wrap"
        alignItems="Stretch"
        width="100%"
    >
        <VBox class="jhahDashboardColMain" renderType="Bare" width="100%">
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.security.StickerSection"
                type="XML"
            />
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.employee.IDManagement"
                type="XML"
            />
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.employee.Appointments"
                type="XML"
            />
        </VBox>
        <!-- Side column holds only the Violations section — collapse it when
             the user has no access, so it does not reserve empty width. -->
        <VBox
            class="jhahDashboardColSide"
            renderType="Bare"
            width="100%"
            visible="{dashboard>/access/violations}"
        >
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.employee.Violations"
                type="XML"
            />
        </VBox>
    </HBox>
</core:FragmentDefinition>
