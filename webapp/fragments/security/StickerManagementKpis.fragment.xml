<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
>
    <VBox class="jhahSection" renderType="Bare">
        <Title text="Sticker Management" level="H5" class="jhahSectionTitle" />
        <HBox class="jhahKpiRow" renderType="Bare" wrap="Wrap">
            <f:Card class="jhahKpiCard jhahAccentBlue jhahThirdCard">
                <f:content>
                    <VBox class="jhahKpiCardInner" renderType="Bare">
                        <Label text="Total In Progress" class="jhahKpiTitle" />
                        <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                    </VBox>
                </f:content>
            </f:Card>
            <f:Card class="jhahKpiCard jhahAccentGreen jhahThirdCard">
                <f:content>
                    <VBox class="jhahKpiCardInner" renderType="Bare">
                        <Label text="Total Raised" class="jhahKpiTitle" />
                        <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                    </VBox>
                </f:content>
            </f:Card>
            <f:Card class="jhahKpiCard jhahAccentBlue jhahThirdCard">
                <f:content>
                    <VBox class="jhahKpiCardInner" renderType="Bare">
                        <Label text="Total Completed" class="jhahKpiTitle" />
                        <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                    </VBox>
                </f:content>
            </f:Card>
        </HBox>
    </VBox>
</core:FragmentDefinition>
