<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <!-- ===================================================== -->
    <!-- ONE ID MANAGEMENT CARD -->
    <!-- ===================================================== -->

    <f:Card
        width="100%"
        binding="{dashboard>/idCard/admin}"
        class="jhahDataCard">

        <f:content>

            <VBox
                width="100%"
                renderType="Bare"
                class="jhahSection">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->


<HBox
    width="100%"
    renderType="Bare"
    alignItems="Center"
    justifyContent="SpaceBetween"
    class="jhahKpiRow">

    <!-- LEFT : Icon + Title -->
    <HBox
        renderType="Bare"
        alignItems="Center">

        <core:Icon
            src="sap-icon://customer-and-contacts"
            class="jhahMutedText sapUiTinyMarginEnd"/>

        <Title
            text="ID Management System"
            level="H5"
            class="jhahSectionTitle"/>

    </HBox>

    <!-- RIGHT : Admin / Employee -->
    <SegmentedButton
        visible="{= ${GetAuthModel>/0/ID_ROLE} === 'ADMIN' }"
        selectedKey="{dashboard>/sectionViewMode/ID_CARD}"
        selectionChange=".onViewModeChange($event, 'ID_CARD')">

        <items>

            <SegmentedButtonItem
                key="org"
                text="Admin"/>

            <SegmentedButtonItem
                key="my"
                text="Employee"/>

        </items>

    </SegmentedButton>

</HBox>


                <!-- ================================================= -->
                <!-- ADMIN KPI CARDS -->
                <!-- ================================================= -->

                <HBox
                    width="100%"
                    class="jhahKpiRow"
                    renderType="Bare"
                    wrap="Wrap">


                    <!-- TOTAL ID REQUEST -->

                    <f:Card
                        class="jhahKpiCard jhahAccentBlue jhahThirdCard jhahKpiCardIcon">

                        <f:content>

                            <HBox
                                class="jhahKpiCardInner jhahKpiCardIconInner"
                                renderType="Bare"
                                alignItems="Center">

                                <core:Icon
                                    src="sap-icon://sum"
                                    class="jhahKpiIcon jhahKpiIconBlue"/>

                                <VBox
                                    class="jhahKpiTextCol"
                                    renderType="Bare">

                                    <Label
                                        text="Total ID Request"
                                        class="jhahKpiTitle"/>

                                    <Text
                                        text="{dashboard>kpi/totalIdRequests}"
                                        class="jhahMutedText jhahNoDataValue"/>

                                </VBox>

                            </HBox>

                        </f:content>

                    </f:Card>


                    <!-- APPROVED -->

                    <f:Card
                        class="jhahKpiCard jhahAccentGreen jhahThirdCard jhahKpiCardIcon">

                        <f:content>

                            <HBox
                                class="jhahKpiCardInner jhahKpiCardIconInner"
                                renderType="Bare"
                                alignItems="Center">

                                <core:Icon
                                    src="sap-icon://accept"
                                    class="jhahKpiIcon jhahKpiIconGreen"/>

                                <VBox
                                    class="jhahKpiTextCol"
                                    renderType="Bare">

                                    <Label
                                        text="Approved"
                                        class="jhahKpiTitle"/>

                                    <Text
                                        text="{dashboard>kpi/approvedCards}"
                                        class="jhahMutedText jhahNoDataValue"/>

                                </VBox>

                            </HBox>

                        </f:content>

                    </f:Card>


                    <!-- PENDING REVIEW -->

                    <f:Card
                        class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">

                        <f:content>

                            <HBox
                                class="jhahKpiCardInner jhahKpiCardIconInner"
                                renderType="Bare"
                                alignItems="Center">

                                <core:Icon
                                    src="sap-icon://pending"
                                    class="jhahKpiIcon jhahKpiIconOrange"/>

                                <VBox
                                    class="jhahKpiTextCol"
                                    renderType="Bare">

                                    <Label
                                        text="Pending Review"
                                        class="jhahKpiTitle"/>

                                    <Text
                                        text="{dashboard>kpi/pendingReview}"
                                        class="jhahMutedText jhahNoDataValue"/>

                                </VBox>

                            </HBox>

                        </f:content>

                    </f:Card>


                    <!-- REJECTED -->

                    <f:Card
                        class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">

                        <f:content>

                            <HBox
                                class="jhahKpiCardInner jhahKpiCardIconInner"
                                renderType="Bare"
                                alignItems="Center">

                                <core:Icon
                                    src="sap-icon://decline"
                                    class="jhahKpiIcon jhahKpiIconRed"/>

                                <VBox
                                    class="jhahKpiTextCol"
                                    renderType="Bare">

                                    <Label
                                        text="Rejected"
                                        class="jhahKpiTitle"/>

                                    <Text
                                        text="{dashboard>kpi/rejectedCards}"
                                        class="jhahMutedText jhahNoDataValue"/>

                                </VBox>

                            </HBox>

                        </f:content>

                    </f:Card>

                </HBox>


                <!-- ================================================= -->
                <!-- COMMON FRAGMENT -->
                <!-- Active ID + In Progress + Request Table -->
                <!-- ================================================= -->

                <core:Fragment
                    fragmentName="com.jhah.zhrjhahseclp.view.fragments.IdManagement.common.common"
                    type="XML"/>


            </VBox>

        </f:content>

    </f:Card>

</core:FragmentDefinition>