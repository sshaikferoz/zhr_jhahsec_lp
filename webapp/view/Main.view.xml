<mvc:View
    controllerName="com.jhah.zhrjhahseclp.controller.Main"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%"
>
    <HBox class="jhahAppShell" renderType="Bare" fitContainer="true" height="100%">
        <core:Fragment
            fragmentName="com.jhah.zhrjhahseclp.fragments.common.SideNavigation"
            type="XML"
        />
        <VBox class="jhahMainColumn" renderType="Bare" height="100%" fitContainer="true">
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.common.Header"
                type="XML"
            />
            <!-- Embed title bar — shows selected menu title above the iframe -->
            <HBox
                visible="{dashboard>/isEmbedFrame}"
                alignItems="Center"
                class="jhahEmbedTitleBar"
                renderType="Bare"
            >
                <core:Icon src="sap-icon://slim-arrow-right" class="jhahEmbedTitleIcon" />
                <Title text="{dashboard>/embedTitle}" level="H5" class="jhahEmbedTitle" />
            </HBox>

            <ScrollContainer
                id="mainScroll"
                width="100%"
                vertical="true"
                horizontal="false"
                class="jhahMainScroll"
            >
                <layoutData>
                    <FlexItemData growFactor="1" baseSize="0%" />
                </layoutData>
                <VBox
                    id="dashboardContent"
                    class="jhahDashboardContent"
                    renderType="Bare"
                    width="100%"
                />
            </ScrollContainer>
        </VBox>
    </HBox>
</mvc:View>
