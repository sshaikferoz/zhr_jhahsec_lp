<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Toolbar class="jhahToolHeader" height="3.25rem" visible="{= !${dashboard>/isEmbedFrame} }">
        <core:Icon src="sap-icon://grid" class="jhahHeaderIcon sapUiSmallMarginBegin" />
        <Title
            text="{dashboard>/pageTitle}"
            level="H4"
            class="jhahPageTitle sapUiSmallMarginBegin"
        />
        <ToolbarSpacer />

        <!-- Admin / My View toggle — only visible for Security role -->
        <SegmentedButton
            visible="{= ${dashboard>/role} === 'SECURITY' }"
            selectedKey="{dashboard>/viewMode}"
            selectionChange=".onViewModeChange"
            class="sapUiSmallMarginEnd"
        >
            <items>
                <SegmentedButtonItem key="org" icon="sap-icon://group"  text="All Employees" />
                <SegmentedButtonItem key="my"  icon="sap-icon://person-placeholder" text="My View" />
            </items>
        </SegmentedButton>

        <Button icon="sap-icon://bell" type="Transparent" class="jhahHeaderIcon" />
        <Button icon="sap-icon://sys-help" type="Transparent" class="jhahHeaderIcon sapUiSmallMarginEnd" />
    </Toolbar>
</core:FragmentDefinition>
