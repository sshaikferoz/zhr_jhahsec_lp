<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <VBox
        class="jhahSection"
        renderType="Bare"
        visible="{dashboard>/access/vendor}"
    >
        <Title text="Business Visitor Access" level="H5" class="jhahSectionTitle" />
        <HBox class="jhahKpiRow" renderType="Bare" wrap="Wrap">
            <f:Card class="jhahKpiCard jhahAccentBlue jhahThirdCard jhahKpiCardIcon">
                <f:content>
                    <HBox class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://supplier" class="jhahKpiIcon jhahKpiIconBlue" />
                        <VBox class="jhahKpiTextCol" renderType="Bare">
                            <Label text="{dashboard>/vendorKpis/0/title}" level="H6" class="jhahKpiTitle" />
                            <ObjectNumber
                                number="{dashboard>/vendorKpis/0/value}"
                                emphasized="true"
                                state="{dashboard>/vendorKpis/0/valueState}"
                                class="jhahKpiValue"
                            />
                        </VBox>
                    </HBox>
                </f:content>
            </f:Card>
            <f:Card class="jhahKpiCard jhahAccentGreen jhahThirdCard jhahKpiCardIcon">
                <f:content>
                    <HBox class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://accept" class="jhahKpiIcon jhahKpiIconGreen" />
                        <VBox class="jhahKpiTextCol" renderType="Bare">
                            <Label text="{dashboard>/vendorKpis/1/title}" level="H6" class="jhahKpiTitle" />
                            <ObjectNumber
                                number="{dashboard>/vendorKpis/1/value}"
                                emphasized="true"
                                state="{dashboard>/vendorKpis/1/valueState}"
                                class="jhahKpiValue"
                            />
                        </VBox>
                    </HBox>
                </f:content>
            </f:Card>
            <f:Card class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">
                <f:content>
                    <HBox class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://pending" class="jhahKpiIcon jhahKpiIconOrange" />
                        <VBox class="jhahKpiTextCol" renderType="Bare">
                            <Label text="{dashboard>/vendorKpis/2/title}" level="H6" class="jhahKpiTitle" />
                            <ObjectNumber
                                number="{dashboard>/vendorKpis/2/value}"
                                emphasized="true"
                                state="{dashboard>/vendorKpis/2/valueState}"
                                class="jhahKpiValue"
                            />
                        </VBox>
                    </HBox>
                </f:content>
            </f:Card>
        </HBox>

        <!-- Visitor Type by Category — grouped under Business Visitor Access -->
        <Title text="Visitor Type by Category" level="H6" class="jhahSubSectionTitle" />
        <f:Card class="jhahDataCard">
            <f:content>
                <VBox width="100%" class="jhahChartWrap">
                    <viz:VizFrame
                        id="visitorCategoryChart"
                        uiConfig="{applicationSet:'fiori'}"
                        vizType="donut"
                        width="100%"
                        height="320px"
                    >
                        <viz:dataset>
                            <viz.data:FlattenedDataset data="{dashboard>/visitorChart/data}">
                                <viz.data:dimensions>
                                    <viz.data:DimensionDefinition
                                        name="Category"
                                        value="{dashboard>Category}"
                                    />
                                </viz.data:dimensions>
                                <viz.data:measures>
                                    <viz.data:MeasureDefinition
                                        name="Count"
                                        value="{dashboard>Count}"
                                    />
                                </viz.data:measures>
                            </viz.data:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <viz.feeds:FeedItem uid="size" type="Measure" values="Count" />
                            <viz.feeds:FeedItem uid="color" type="Dimension" values="Category" />
                        </viz:feeds>
                    </viz:VizFrame>
                </VBox>
            </f:content>
        </f:Card>
    </VBox>
</core:FragmentDefinition>
