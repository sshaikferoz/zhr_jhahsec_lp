<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <!-- ID Management System, admin view: organization-wide request counts
         and all pending requests. -->
    <f:Card id="_IDGenCard1"
        width="100%"
        binding="{dashboard>/idCard/admin}"
        class="jhahDataCard">
        <f:content>
            <VBox id="_IDGenVBox" width="100%" renderType="Bare" class="jhahSection">

                <HBox id="_IDGenHBox"
                    width="100%"
                    renderType="Bare"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="jhahKpiRow">
                    <HBox id="_IDGenHBox1" renderType="Bare" alignItems="Center">
                        <Title
                            id="title1"
                            text="{i18n>idCardTitle}"
                            level="H5"
                            class="jhahSectionTitle"/>
                    </HBox>
                    <!-- visible="{dashboard>/hasAdminSection}" -->
                    <SegmentedButton
                        id="viewModeToggleA"
                        ariaLabelledBy="title"                        
                        visible="{dashboard>/sections/idCard/isAdmin}"
                        selectedKey="{dashboard>/sections/idCard/viewMode}"
                        selectionChange=".onViewModeChange($event, 'idCard')"
                        width="180px">
                        <items>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem" key="admin" text="{i18n>viewModeAdmin}"/>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem1" key="employee" text="{i18n>viewModeEmployee}"/>
                        </items>
                    </SegmentedButton>
                </HBox>

                <HBox id="_IDGenHBox2" width="100%" class="jhahKpiRow" renderType="Bare" wrap="Wrap">
                    <f:Card id="_IDGenCard2" class="jhahKpiCard jhahAccentBlue jhahThirdCard jhahKpiCardIcon">
                        <f:content>
                            <HBox id="_IDGenHBox3" class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                                <core:Icon id="_IDGenIcon" src="sap-icon://sum" class="jhahKpiIcon jhahKpiIconBlue"/>
                                <VBox id="_IDGenVBox1" class="jhahKpiTextCol" renderType="Bare">
                                    <Label id="_IDGenLabel" text="{i18n>idCardKpiTotal}" class="jhahKpiTitle"/>
                                    <Text id="_IDGenText" text="{dashboard>kpi/totalIdRequests}" class="jhahMutedText jhahNoDataValue"/>
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>
                    <f:Card id="_IDGenCard3" class="jhahKpiCard jhahAccentGreen jhahThirdCard jhahKpiCardIcon">
                        <f:content>
                            <HBox id="_IDGenHBox4" class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                                <core:Icon id="_IDGenIcon1" src="sap-icon://accept" class="jhahKpiIcon jhahKpiIconGreen"/>
                                <VBox id="_IDGenVBox2" class="jhahKpiTextCol" renderType="Bare">
                                    <Label id="_IDGenLabel1" text="{i18n>kpiApproved}" class="jhahKpiTitle"/>
                                    <Text id="_IDGenText1" text="{dashboard>kpi/approvedCards}" class="jhahMutedText jhahNoDataValue"/>
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>
                    <f:Card id="_IDGenCard4" class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">
                        <f:content>
                            <HBox id="_IDGenHBox5" class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                                <core:Icon id="_IDGenIcon2" src="sap-icon://pending" class="jhahKpiIcon jhahKpiIconOrange"/>
                                <VBox id="_IDGenVBox3" class="jhahKpiTextCol" renderType="Bare">
                                    <Label id="_IDGenLabel2" text="{i18n>kpiPendingReview}" class="jhahKpiTitle"/>
                                    <Text id="_IDGenText2" text="{dashboard>kpi/pendingReview}" class="jhahMutedText jhahNoDataValue"/>
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>
                    <f:Card id="_IDGenCard5" class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">
                        <f:content>
                            <HBox id="_IDGenHBox6" class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                                <core:Icon id="_IDGenIcon3" src="sap-icon://decline" class="jhahKpiIcon jhahKpiIconRed"/>
                                <VBox id="_IDGenVBox4" class="jhahKpiTextCol" renderType="Bare">
                                    <Label id="_IDGenLabel3" text="{i18n>kpiRejected}" class="jhahKpiTitle"/>
                                    <Text id="_IDGenText3" text="{dashboard>kpi/rejectedCards}" class="jhahMutedText jhahNoDataValue"/>
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>
                </HBox>

                <core:Fragment
                    fragmentName="com.jhah.zhrjhahseclp.view.fragments.idcard.IdCardRequests"
                    type="XML"/>

            </VBox>
        </f:content>
    </f:Card>

</core:FragmentDefinition>
