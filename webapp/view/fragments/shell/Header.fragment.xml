<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Toolbar
        class="jhahToolHeader"
        height="3.25rem"
        visible="{= !${dashboard>/isEmbedFrame} }">
        <core:Icon
            src="sap-icon://grid"
            class="jhahHeaderIcon sapUiSmallMarginBegin"/>
        <Title
            text="{i18n>dashboardTitle}"
            level="H4"
            class="jhahPageTitle sapUiSmallMarginBegin"/>
        <ToolbarSpacer/>
        <Button
            icon="sap-icon://bell"
            type="Transparent"
            tooltip="{i18n>notificationsTooltip}"
            class="jhahHeaderIcon"/>
        <Button
            icon="sap-icon://sys-help"
            type="Transparent"
            tooltip="{i18n>helpTooltip}"
            class="jhahHeaderIcon sapUiSmallMarginEnd"/>
    </Toolbar>
</core:FragmentDefinition>
