<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <!-- Sticker Management, employee view: the user's own request counts and
         their active sticker. -->
    <f:Card id="_IDGenCard10"
        width="100%"
        binding="{dashboard>/sticker/employee}"
        class="jhahDataCard">
        <f:content>
            <VBox id="_IDGenVBox16" width="100%" renderType="Bare" class="jhahSection">

                <HBox id="_IDGenHBox16"
                    width="100%"
                    renderType="Bare"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="jhahKpiRow">
                    <HBox id="_IDGenHBox17" renderType="Bare" alignItems="Center">
                        <Title
                            id="title4"
                            text="{i18n>stickerTitle}"
                            level="H5"
                            class="jhahSectionTitle"/>
                    </HBox>
                    <!-- visible="{dashboard>/hasAdminSection}" -->
                    <SegmentedButton
                        id="viewModeToggleSE"
                        ariaLabelledBy="title"                        
                        visible="{dashboard>/sections/sticker/isAdmin}"
                        selectedKey="{dashboard>/sections/sticker/viewMode}"
                        selectionChange=".onViewModeChange($event, 'sticker')">
                        <items>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem6" key="admin" text="{i18n>viewModeAdmin}"/>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem7" key="employee" text="{i18n>viewModeEmployee}"/>
                        </items>
                    </SegmentedButton>
                </HBox>

                <core:Fragment
                    fragmentName="com.jhah.zhrjhahseclp.view.fragments.sticker.StickerKpis"
                    type="XML"/>

                <HBox id="_IDGenHBox18" class="jhahTwoColRow" renderType="Bare" alignItems="Stretch" width="100%">
                    <VBox id="_IDGenVBox17"
                        binding="{dashboard>/sticker/own/active}"
                        class="jhahHalfCardWrap"
                        renderType="Bare">
                        <layoutData>
                            <FlexItemData id="_IDGenFlexItemData2" growFactor="1" baseSize="0%"/>
                        </layoutData>
                        <f:Card id="_IDGenCard11" class="jhahDataCard" width="100%">
                            <f:content>
                                <VBox id="_IDGenVBox18" class="jhahPairCardInner" renderType="Bare" justifyContent="Start" width="100%">
                                    <Label id="_IDGenLabel7" text="{i18n>stickerActive}" class="jhahMutedText"/>

                                    <!-- No active sticker -->
                                    <Text id="_IDGenText11"
                                        text="{i18n>noData}"
                                        class="jhahMutedText jhahNoDataValue"
                                        visible="{= !${dashboard>hasData} }"/>

                                    <!-- Active sticker details -->
                                    <VBox id="_IDGenVBox19"
                                        renderType="Bare"
                                        class="jhahActiveSticker"
                                        visible="{dashboard>hasData}">
                                        <HBox id="_IDGenHBox19" alignItems="Center">
                                            <Avatar id="_IDGenAvatar"
                                                src="sap-icon://car-rental"
                                                displaySize="S"
                                                displayShape="Square"
                                                backgroundColor="Accent6"
                                                class="sapUiSmallMarginEnd"/>
                                            <VBox id="_IDGenVBox20" renderType="Bare">
                                                <Title id="_IDGenTitle"
                                                    text="{dashboard>plate}"
                                                    level="H5"
                                                    class="jhahHighlightValue"/>
                                                <ObjectAttribute id="_IDGenObjectAttribute" text="{dashboard>type}"/>
                                            </VBox>
                                        </HBox>
                                        <ObjectAttribute id="_IDGenObjectAttribute1"
                                            text="{dashboard>vehicle}"
                                            class="sapUiTinyMarginTop"
                                            visible="{= !!${dashboard>vehicle} }"/>
                                        <HBox id="_IDGenHBox20"
                                            class="jhahActiveStickerFooter sapUiSmallMarginTop"
                                            alignItems="Center"
                                            justifyContent="SpaceBetween">
                                            <ObjectStatus id="_IDGenObjectStatus2"
                                                text="{dashboard>status}"
                                                state="{dashboard>statusState}"/>
                                            <ObjectAttribute id="_IDGenObjectAttribute2"
                                                title="{i18n>stickerExpires}"
                                                text="{dashboard>expiry}"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </VBox>
                </HBox>

            </VBox>
        </f:content>
    </f:Card>

</core:FragmentDefinition>
