<mvc:View
    controllerName="com.jhah.zhrjhahseclp.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page
        id="page"
        showHeader="false"
        enableScrolling="false">
        <content>
            <HBox
                width="100%"
                height="100%"
                renderType="Bare"
                class="jhahAppLayout">

                <!-- Side navigation -->
                <VBox
                    width="350px"
                    height="100%"
                    renderType="Bare"
                    class="jhahSideNavContainer">
                    <core:Fragment
                        fragmentName="com.jhah.zhrjhahseclp.view.fragments.shell.SideNavigation"
                        type="XML"/>
                </VBox>

                <!-- Main area -->
                <VBox
                    width="calc(100% - 350px)"
                    height="100%"
                    renderType="Bare"
                    class="jhahMainArea">

                    <VBox
                        width="100%"
                        renderType="Bare"
                        class="jhahHeaderContainer">
                        <layoutData>
                            <FlexItemData
                                growFactor="0"
                                shrinkFactor="0"/>
                        </layoutData>
                        <core:Fragment
                            fragmentName="com.jhah.zhrjhahseclp.view.fragments.shell.Header"
                            type="XML"/>
                    </VBox>

                    <ScrollContainer
                        id="dashboardScroll"
                        width="100%"
                        vertical="true"
                        horizontal="false"
                        class="jhahDashboardScroll">
                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>
                        </layoutData>

                        <VBox
                            id="dashboardContent"
                            width="100%"
                            renderType="Bare"
                            class="jhahDashboardContent">

                            <!-- Hidden (not destroyed) while another app is embedded,
                                 so returning to the dashboard keeps its state. -->
                            <VBox
                                id="dashboardContainer"
                                width="100%"
                                renderType="Bare"
                                visible="{= !${dashboard>/isEmbedFrame} }"
                                class="jhahDashboardContainer">

                                <!-- Each section has one slot per view. Main.controller
                                     loads the section fragment into the slot on first
                                     use; the section's view mode decides which slot
                                     is on screen. -->
                                <HBox
                                    width="100%"
                                    renderType="Bare"
                                    alignItems="Start"
                                    justifyContent="SpaceBetween"
                                    class="jhahDashboardRow">

                                    <!-- Left column -->
                                    <VBox
                                        width="49%"
                                        renderType="Bare"
                                        class="jhahDashboardColumn">

                                        <VBox
                                            id="visitorSection"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= !!${dashboard>/sections/visitor/viewMode} }"
                                            class="jhahDashboardCard jhahDashboardCardSpacing">
                                            <VBox
                                                id="visitorAdminSlot"
                                                width="100%"
                                                renderType="Bare"
                                                visible="{= ${dashboard>/sections/visitor/viewMode} === 'admin' }"/>
                                            <VBox
                                                id="visitorEmployeeSlot"
                                                width="100%"
                                                renderType="Bare"
                                                visible="{= ${dashboard>/sections/visitor/viewMode} === 'employee' }"/>
                                        </VBox>

                                        <VBox
                                            id="idCardSection"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= !!${dashboard>/sections/idCard/viewMode} }"
                                            class="jhahDashboardCard">
                                            <VBox
                                                id="idCardAdminSlot"
                                                width="100%"
                                                renderType="Bare"
                                                visible="{= ${dashboard>/sections/idCard/viewMode} === 'admin' }"/>
                                            <VBox
                                                id="idCardEmployeeSlot"
                                                width="100%"
                                                renderType="Bare"
                                                visible="{= ${dashboard>/sections/idCard/viewMode} === 'employee' }"/>
                                        </VBox>

                                    </VBox>

                                    <!-- Right column -->
                                    <VBox
                                        width="49%"
                                        renderType="Bare"
                                        class="jhahDashboardColumn">

                                        <VBox
                                            id="violationsSection"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= !!${dashboard>/sections/violations/viewMode} }"
                                            class="jhahDashboardCard jhahDashboardCardSpacing">
                                            <VBox
                                                id="violationsAdminSlot"
                                                width="100%"
                                                renderType="Bare"
                                                visible="{= ${dashboard>/sections/violations/viewMode} === 'admin' }"/>
                                            <VBox
                                                id="violationsEmployeeSlot"
                                                width="100%"
                                                renderType="Bare"
                                                visible="{= ${dashboard>/sections/violations/viewMode} === 'employee' }"/>
                                        </VBox>

                                        <VBox
                                            id="stickerSection"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= !!${dashboard>/sections/sticker/viewMode} }"
                                            class="jhahDashboardCard">
                                            <VBox
                                                id="stickerAdminSlot"
                                                width="100%"
                                                renderType="Bare"
                                                visible="{= ${dashboard>/sections/sticker/viewMode} === 'admin' }"/>
                                            <VBox
                                                id="stickerEmployeeSlot"
                                                width="100%"
                                                renderType="Bare"
                                                visible="{= ${dashboard>/sections/sticker/viewMode} === 'employee' }"/>
                                        </VBox>

                                    </VBox>

                                </HBox>

                            </VBox>

                            <!-- Takes the application opened from the side navigation. -->
                            <VBox
                                id="embeddedApp"
                                width="100%"
                                renderType="Bare"
                                visible="{dashboard>/isEmbedFrame}"/>

                        </VBox>

                    </ScrollContainer>

                </VBox>

            </HBox>
        </content>
    </Page>
</mvc:View>
