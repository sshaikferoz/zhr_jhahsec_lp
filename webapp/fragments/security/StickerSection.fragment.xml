<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <!--
        Sticker Management section.
        Hidden entirely for users without access to the Sticker app. Otherwise
        renders the admin KPI-card view for Sticker Admins and the personal
        StickerMaster view for everyone else. Both sub-fragments are
        instantiated; only the one matching dashboard>/sticker/isAdmin shows.
    -->
    <VBox
        renderType="Bare"
        width="100%"
        visible="{= ${dashboard>/access/sticker} &amp;&amp; ${dashboard>/sticker/isAdmin} }"
    >
        <core:Fragment
            fragmentName="com.jhah.zhrjhahseclp.fragments.security.StickerManagementKpis"
            type="XML"
        />
    </VBox>
    <VBox
        renderType="Bare"
        width="100%"
        visible="{= ${dashboard>/access/sticker} &amp;&amp; !${dashboard>/sticker/isAdmin} }"
    >
        <core:Fragment
            fragmentName="com.jhah.zhrjhahseclp.fragments.employee.StickerManagement"
            type="XML"
        />
    </VBox>
</core:FragmentDefinition>
