<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <!-- ID Management System, employee view: the user's active ID card and
         their own pending requests. -->
    <f:Card id="_IDGenCard6"
        width="100%"
        binding="{dashboard>/idCard/employee}"
        class="jhahDataCard">
        <f:content>
            <VBox id="_IDGenVBox5" width="100%" renderType="Bare" class="jhahSection">

                <HBox id="_IDGenHBox7"
                    width="100%"
                    renderType="Bare"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="jhahKpiRow">
                    <HBox id="_IDGenHBox8" renderType="Bare" alignItems="Center">
                        <Title
                            id="title2"
                            text="{i18n>idCardTitle}"
                            level="H5"
                            class="jhahSectionTitle"/>
                    </HBox>
                    <!-- visible="{dashboard>/hasAdminSection}" -->
                    <SegmentedButton
                        id="viewModeToggleE"
                        ariaLabelledBy="title"                        
                        visible="{dashboard>/sections/idCard/isAdmin}"
                        selectedKey="{dashboard>/sections/idCard/viewMode}"
                        selectionChange=".onViewModeChange($event, 'idCard')">
                        <items>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem2" key="admin" text="{i18n>viewModeAdmin}"/>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem3" key="employee" text="{i18n>viewModeEmployee}"/>
                        </items>
                    </SegmentedButton>
                </HBox>

                <VBox id="_IDGenVBox6" class="jhahSection" renderType="Bare">

                    <HBox id="_IDGenHBox9" class="jhahTwoColRow" renderType="Bare" alignItems="Stretch" width="100%">
                        <VBox id="_IDGenVBox7" class="jhahHalfCardWrap" renderType="Bare" width="100%">
                            <layoutData>
                                <FlexItemData id="_IDGenFlexItemData" growFactor="1" baseSize="0%"/>
                            </layoutData>
                            <f:Card id="_IDGenCard7" class="jhahDataCard" width="100%">
                                <f:content>
                                    <VBox id="_IDGenVBox8" class="jhahPairCardInner" renderType="Bare" justifyContent="Start" width="100%">

                                        <!-- The user has an active card -->
                                        <VBox id="_IDGenVBox9"
                                            visible="{dashboard>active/hasData}"
                                            renderType="Bare"
                                            width="100%"
                                            class="jhahIdCardBody">
                                            <HBox id="_IDGenHBox10"
                                                class="jhahIdCardHeader"
                                                renderType="Bare"
                                                width="100%"
                                                justifyContent="SpaceBetween"
                                                alignItems="Center">
                                                <HBox id="_IDGenHBox11" renderType="Bare" alignItems="Center">
                                                    <core:Icon id="_IDGenIcon4" src="sap-icon://badge" class="jhahIdCardHeaderIcon"/>
                                                    <VBox id="_IDGenVBox10" class="jhahIdCardHeaderText" renderType="Bare">
                                                        <Label id="_IDGenLabel4" text="{i18n>idCardActive}" class="jhahMutedText"/>
                                                        <Text id="_IDGenText4"
                                                            text="{dashboard>active/idNumber}"
                                                            tooltip="{dashboard>active/idNumber}"
                                                            class="jhahIdCardName"/>
                                                    </VBox>
                                                </HBox>
                                                <ObjectStatus id="_IDGenObjectStatus"
                                                    text="{= ${dashboard>active/isExpiringSoon} ? ${i18n>idCardStatusExpiringSoon} : ${i18n>idCardStatusActive} }"
                                                    state="{dashboard>active/statusState}"
                                                    class="jhahBadgeStatus"/>
                                            </HBox>

                                            <VBox id="_IDGenVBox11" class="jhahIdCardExpiry" renderType="Bare" width="100%">
                                                <HBox id="_IDGenHBox12" justifyContent="SpaceBetween" class="jhahIdCardRow" renderType="Bare">
                                                    <Label id="_IDGenLabel5" text="{i18n>idCardDaysToExpiry}" class="jhahIdCardLabel"/>
                                                    <Text id="_IDGenText5" text="{dashboard>active/daysToExpire}" class="jhahIdCardValue"/>
                                                </HBox>
                                                <ProgressIndicator id="_IDGenProgressIndicator"
                                                    percentValue="{dashboard>active/expiryPercent}"
                                                    showValue="false"
                                                    state="{dashboard>active/statusState}"
                                                    class="jhahExpiryProgress"/>
                                            </VBox>
                                        </VBox>

                                        <!-- No active card -->
                                        <VBox id="_IDGenVBox12"
                                            visible="{= !${dashboard>active/hasData} }"
                                            renderType="Bare"
                                            justifyContent="Start"
                                            width="100%">
                                            <Label id="_IDGenLabel6" text="{i18n>idCardActive}" class="jhahMutedText"/>
                                            <Text id="_IDGenText6" text="{i18n>noData}" class="jhahMutedText jhahNoDataValue"/>
                                        </VBox>

                                    </VBox>
                                </f:content>
                            </f:Card>
                        </VBox>
                    </HBox>

                    <core:Fragment
                        fragmentName="com.jhah.zhrjhahseclp.view.fragments.idcard.IdCardRequests"
                        type="XML"/>

                </VBox>

            </VBox>
        </f:content>
    </f:Card>

</core:FragmentDefinition>
