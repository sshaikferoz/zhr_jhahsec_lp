<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <VBox
        id="employeeKpiSection"
        class="jhahSection"
        renderType="Bare"
        visible="{dashboard>/access/id}">

        <Title
            id="employeeKpiTitle"
            text=""
            level="H5"
            class="jhahSectionTitle" />

        <HBox
            id="employeeKpiRow"
            class="jhahKpiRow"
            renderType="Bare"
            wrap="Wrap">

            <!-- ================================================= -->
            <!-- ACTIVE REQUESTS -->
            <!-- ================================================= -->

            <f:Card
                id="cardActiveRequests"
                class="jhahKpiCard jhahAccentBlue jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="activeRequestsInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="activeRequestsIcon"
                            src="sap-icon://pending"
                            class="jhahKpiIcon jhahKpiIconBlue" />

                        <VBox
                            id="activeRequestsTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="activeRequestsLabel"
                                text="Active Requests"
                                class="jhahKpiTitle" />

                            <Text
                                id="activeRequestsValue"
                                text="{dashboard>/idCard/empKpi/activeRequestsCount}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- ACCESS REQUESTS -->
            <!-- ================================================= -->

            <f:Card
                id="cardAccessRequests"
                class="jhahKpiCard jhahAccentGreen jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="accessRequestsInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="accessRequestsIcon"
                            src="sap-icon://key"
                            class="jhahKpiIcon jhahKpiIconGreen" />

                        <VBox
                            id="accessRequestsTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="accessRequestsLabel"
                                text="Access Requests"
                                class="jhahKpiTitle" />

                            <Text
                                id="accessRequestsValue"
                                text="{dashboard>/idCard/empKpi/accessRequestCount}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- RENEWAL REQUESTS -->
            <!-- ================================================= -->

            <f:Card
                id="cardRenewalRequests"
                class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="renewalRequestsInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="renewalRequestsIcon"
                            src="sap-icon://refresh"
                            class="jhahKpiIcon jhahKpiIconOrange" />

                        <VBox
                            id="renewalRequestsTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="renewalRequestsLabel"
                                text="Renewal Requests"
                                class="jhahKpiTitle" />

                            <Text
                                id="renewalRequestsValue"
                                text="{dashboard>/idCard/empKpi/renewalRequestCount}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- LOST / REPLACE -->
            <!-- ================================================= -->

            <f:Card
                id="cardLostReplace"
                class="jhahKpiCard jhahAccentRed jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="lostReplaceInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="lostReplaceIcon"
                            src="sap-icon://edit"
                            class="jhahKpiIcon jhahKpiIconRed" />

                        <VBox
                            id="lostReplaceTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="lostReplaceLabel"
                                text="Lost / Replace"
                                class="jhahKpiTitle" />

                            <Text
                                id="lostReplaceValue"
                                text="{dashboard>/idCard/empKpi/lostReplaceRequestCount}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- REJECTED REQUESTS -->
            <!-- ================================================= -->

            <f:Card
                id="cardRejectedRequests"
                class="jhahKpiCard jhahAccentRed jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="rejectedRequestsInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="rejectedRequestsIcon"
                            src="sap-icon://decline"
                            class="jhahKpiIcon jhahKpiIconRed" />

                        <VBox
                            id="rejectedRequestsTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="rejectedRequestsLabel"
                                text="Rejected Requests"
                                class="jhahKpiTitle" />

                            <Text
                                id="rejectedRequestsValue"
                                text="{dashboard>/idCard/empKpi/rejectedRequestCount}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>


            <!-- ================================================= -->
            <!-- DAYS TO EXPIRY -->
            <!-- ================================================= -->

            <f:Card
                id="cardDaysToExpiry"
                class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">

                <f:content>
                    <HBox
                        id="daysToExpiryInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="daysToExpiryIcon"
                            src="sap-icon://date-time"
                            class="jhahKpiIcon jhahKpiIconOrange" />

                        <VBox
                            id="daysToExpiryTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="daysToExpiryLabel"
                                text="Days to Expiry"
                                class="jhahKpiTitle" />

                            <Text
                                id="daysToExpiryValue"
                                text="{dashboard>/idCard/empKpi/daysToExpiry}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>
                </f:content>

            </f:Card>

        </HBox>

    </VBox>

</core:FragmentDefinition>