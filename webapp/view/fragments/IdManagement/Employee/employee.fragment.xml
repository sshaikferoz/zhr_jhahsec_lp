<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
>



    <f:Card
        width="100%"
        binding="{dashboard>/idCard/employee}"
        class="jhahDataCard">

        <f:content>

            <VBox
                width="100%"
                renderType="Bare"
                class="jhahSection">


  <HBox
    width="100%"
    renderType="Bare"
    alignItems="Center"
    justifyContent="SpaceBetween"
    class="jhahKpiRow">

    <!-- LEFT : Icon + Title -->
    <HBox
        renderType="Bare"
        alignItems="Center">

        <core:Icon
            src="sap-icon://customer-and-contacts"
            class="jhahMutedText sapUiTinyMarginEnd"/>

        <Title
            text="IDcard Management System"
            level="H5"
            class="jhahSectionTitle"/>

    </HBox>

    <!-- RIGHT : Admin / Employee -->
    <SegmentedButton
        visible="{= ${GetAuthModel>/0/ID_ROLE} === 'ADMIN' }"
        selectedKey="{dashboard>/sectionViewMode/ID_CARD}"
        selectionChange=".onViewModeChange($event, 'ID_CARD')">

        <items>

            <SegmentedButtonItem
                key="org"
                text="Admin"/>

            <SegmentedButtonItem
                key="my"
                text="Employee"/>

        </items>

    </SegmentedButton>

</HBox>
<VBox
        class="jhahSection"
        renderType="Bare"
        visible="{dashboard>/access/id}"
    >
       
        <HBox class="jhahTwoColRow" renderType="Bare" alignItems="Stretch" width="100%">
            <!-- Active ID Card — reconstructed from the reference project's
                 ActiveIdCard fragment contract (ID number, days-to-expiry,
                 expiring-soon flag gating Renew), fed by /activeID. -->
            <VBox class="jhahHalfCardWrap" renderType="Bare" width="100%">
                <layoutData>
                    <FlexItemData growFactor="1" baseSize="0%" />
                </layoutData>
                <f:Card class="jhahDataCard" width="100%">
                    <f:content>
                        <VBox class="jhahPairCardInner" renderType="Bare" justifyContent="Start" width="100%">
                            <!-- Populated state -->
                            <VBox
                                visible="{dashboard>active/hasData}"
                                renderType="Bare"
                                width="100%"
                                class="jhahIdCardBody"
                            >
                                <HBox
                                    class="jhahIdCardHeader"
                                    renderType="Bare"
                                    width="100%"
                                    justifyContent="SpaceBetween"
                                    alignItems="Center"
                                >
                                    <HBox renderType="Bare" alignItems="Center">
                                        <core:Icon src="sap-icon://badge" class="jhahIdCardHeaderIcon" />
                                        <VBox class="jhahIdCardHeaderText" renderType="Bare">
                                            <Label text="ACTIVE ID CARD" class="jhahMutedText" />
                                            <Text
                                                text="{dashboard>active/idNumber}"
                                                tooltip="{dashboard>active/idNumber}"
                                                class="jhahIdCardName"
                                            />
                                        </VBox>
                                    </HBox>
                                    <ObjectStatus
                                        text="{dashboard>active/statusText}"
                                        state="{dashboard>active/statusState}"
                                        class="jhahBadgeStatus"
                                    />
                                </HBox>

                                <VBox class="jhahIdCardExpiry" renderType="Bare" width="100%">
                                    <HBox justifyContent="SpaceBetween" class="jhahIdCardRow" renderType="Bare">
                                        <Label text="Days to Expiry" class="jhahIdCardLabel" />
                                        <Text text="{dashboard>active/daysToExpire}" class="jhahIdCardValue" />
                                    </HBox>
                                    <ProgressIndicator
                                        percentValue="{dashboard>active/expiryPercent}"
                                        showValue="false"
                                        state="{dashboard>active/statusState}"
                                        class="jhahExpiryProgress"
                                    />
                                </VBox>

                                <!-- Renew ID Card: hidden for now, uncomment to show.
                                <Button
                                    text="Renew ID Card"
                                    type="Emphasized"
                                    icon="sap-icon://request"
                                    enabled="{dashboard>active/isExpiringSoon}"
                                    tooltip="{= ${dashboard>active/isExpiringSoon} ? 'Your ID is eligible for renewal.' : 'Renewal is available within 30 days of your ID expiration.' }"
                                    press=".onRenewIdCard"
                                    class="jhahRenewBtn"
                                />
                                -->
                            </VBox>

                            <!-- Empty state -->
                            <VBox
                                visible="{= !${dashboard>active/hasData} }"
                                renderType="Bare"
                                justifyContent="Start"
                                width="100%"
                            >
                                <Label text="ACTIVE ID CARD" class="jhahMutedText" />
                                <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                            </VBox>
                        </VBox>
                    </f:content>
                </f:Card>
            </VBox>
            <!-- In Progress Request card -->
            <VBox class="jhahHalfCardWrap" renderType="Bare" visible="false" width="100%">
                <layoutData>
                    <FlexItemData growFactor="1" baseSize="0%" />
                </layoutData>
                <f:Card class="jhahDataCard" width="100%">
                    <f:content>
                        <VBox class="jhahPairCardInner" renderType="Bare" justifyContent="Start" width="100%">
                            <Label text="IN PROGRESS REQUEST" class="jhahMutedText" />
                            <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                        </VBox>
                    </f:content>
                </f:Card>
            </VBox>
        </HBox>
   
<core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.view.fragments.IdManagement.common.common"
                type="XML"
            />
            </VBox>
 </VBox>
        </f:content>

    </f:Card>

</core:FragmentDefinition>