<mvc:View
controllerName="com.jhah.zhrjhahseclp.controller.Main"
xmlns:mvc="sap.ui.core.mvc"
xmlns="sap.m"
xmlns:core="sap.ui.core">
<Page
    showHeader="false"
    enableScrolling="false">

    <content>

        <!-- ===================================================== -->
        <!-- APPLICATION SHELL -->
        <!-- ===================================================== -->

        <HBox
            width="100%"
            height="100%"
            renderType="Bare"
            class="jhahAppLayout">

            <!-- ================================================= -->
            <!-- SIDE NAVIGATION -->
            <!-- ================================================= -->

            <VBox
                width="350px"
                height="100%"
                renderType="Bare"
                class="jhahSideNavContainer">

                <core:Fragment
                    fragmentName="com.jhah.zhrjhahseclp.view.fragments.common.SideNavigation"
                    type="XML"/>

            </VBox>


            <!-- ================================================= -->
            <!-- MAIN AREA -->
            <!-- ================================================= -->

            <VBox
                width="calc(100% - 350px)"
                height="100%"
                renderType="Bare"
                class="jhahMainArea">

                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <VBox
                    width="100%"
                    renderType="Bare"
                    class="jhahHeaderContainer">

                    <layoutData>
                        <FlexItemData
                            growFactor="0"
                            shrinkFactor="0"/>
                    </layoutData>

                    <core:Fragment
                        fragmentName="com.jhah.zhrjhahseclp.view.fragments.common.Header"
                        type="XML"/>

                </VBox>


                <!-- ================================================= -->
                <!-- DASHBOARD SCROLL AREA -->
                <!-- ================================================= -->

                <ScrollContainer
                    width="100%"
                    vertical="true"
                    horizontal="false"
                    class="jhahDashboardScroll">

                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>
                    </layoutData>


                    <!-- ================================================= -->
                    <!-- DASHBOARD CONTENT -->
                    <!-- ================================================= -->

                    <VBox
                        id="dashboardContent"
                        width="100%"
                        renderType="Bare"
                        class="jhahDashboardContent">

                        <!-- Hidden (not destroyed) while another app is embedded,
                             so returning to the dashboard keeps its state. -->
                        <VBox
                            id="dashboardContainer"
                            width="100%"
                            renderType="Bare"
                            visible="{= !${dashboard>/isEmbedFrame} }"
                            class="jhahDashboardContainer">

                            <!-- ================================================= -->
                            <!-- TWO COLUMN LAYOUT -->
                            <!-- ================================================= -->

                            <HBox
                                width="100%"
                                renderType="Bare"
                                alignItems="Start"
                                justifyContent="SpaceBetween"
                                class="jhahDashboardRow">


                                <!-- ============================================= -->
                                <!-- LEFT COLUMN -->
                                <!-- VAR + ID MANAGEMENT -->
                                <!-- ============================================= -->

                                <VBox
                                    width="49%"
                                    renderType="Bare"
                                    class="jhahDashboardColumn">


                                    <!-- ========================================= -->
                                    <!-- VAR / BUSINESS VISITOR -->
                                    <!-- ========================================= -->

                                    <VBox
                                        id="varVBox"
                                        width="100%"
                                        renderType="Bare"
                                        class="jhahDashboardCard jhahDashboardCardSpacing">

                                        <VBox
                                            id="varOrgVBox"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= ${dashboard>/sectionViewMode/BUSINESS_VISITOR} === 'org' }"/>

                                        <VBox
                                            id="varMyVBox"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= ${dashboard>/sectionViewMode/BUSINESS_VISITOR} === 'my' }"/>
                                    </VBox>


                                    <!-- ========================================= -->
                                    <!-- ID MANAGEMENT -->
                                    <!-- ========================================= -->

                                    <VBox
                                        id="idVBox"
                                        width="100%"
                                        renderType="Bare"
                                        class="jhahDashboardCard">

                                        <VBox
                                            id="idOrgVBox"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= ${dashboard>/sectionViewMode/ID_CARD} === 'org' }"/>

                                        <VBox
                                            id="idMyVBox"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= ${dashboard>/sectionViewMode/ID_CARD} === 'my' }"/>
                                    </VBox>

                                </VBox>


                                <!-- ============================================= -->
                                <!-- RIGHT COLUMN -->
                                <!-- TVS + STICKER -->
                                <!-- ============================================= -->

                                <VBox
                                    width="49%"
                                    renderType="Bare"
                                    class="jhahDashboardColumn">


                                    <!-- ========================================= -->
                                    <!-- TVS -->
                                    <!-- ========================================= -->

                                    <VBox
                                        id="tvsVBox"
                                        width="100%"
                                        renderType="Bare"
                                        class="jhahDashboardCard jhahDashboardCardSpacing">

                                        <VBox
                                            id="tvsOrgVBox"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= ${dashboard>/sectionViewMode/TVS} === 'org' }"/>

                                        <VBox
                                            id="tvsMyVBox"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= ${dashboard>/sectionViewMode/TVS} === 'my' }"/>
                                    </VBox>


                                    <!-- ========================================= -->
                                    <!-- STICKER -->
                                    <!-- ========================================= -->

                                    <VBox
                                        id="stickerVBox"
                                        width="100%"
                                        renderType="Bare"
                                        class="jhahDashboardCard">

                                        <VBox
                                            id="stickerOrgVBox"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= ${dashboard>/sectionViewMode/STICKER} === 'org' }"/>

                                        <VBox
                                            id="stickerMyVBox"
                                            width="100%"
                                            renderType="Bare"
                                            visible="{= ${dashboard>/sectionViewMode/STICKER} === 'my' }"/>
                                    </VBox>

                                </VBox>

                            </HBox>

                        </VBox>

                    </VBox>

                </ScrollContainer>

            </VBox>

        </HBox>

    </content>

</Page>

</mvc:View>
