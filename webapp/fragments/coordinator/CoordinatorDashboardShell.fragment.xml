<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <HBox id="_IDGenHBox1"
        class="jhahDashboardGrid"
        renderType="Bare"
        wrap="Wrap"
        alignItems="Stretch"
        width="100%"
    >
        <VBox id="_IDGenVBox" class="jhahDashboardColMain" renderType="Bare" width="100%">
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.coordinator.VendorManagement"
                type="XML"
            />

            <VBox id="_IDGenVBox1">
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.employee.IDManagement"
                type="XML"
            />

            <!-- nithya code -->
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.coordinator.HRCard"
                type="XML"
            />
            </VBox>
        </VBox>
        <!-- Side column holds only app-specific sections — collapse it when the
             user has access to neither, so it does not reserve empty width. -->
        <VBox id="_IDGenVBox2"
            class="jhahDashboardColSide"
            renderType="Bare"
            width="100%"
            visible="{= ${dashboard>/access/violations} || ${dashboard>/access/vendor} }"
        >
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.security.ViolationsSection"
                type="XML"
            />
            <core:Fragment
                fragmentName="com.jhah.zhrjhahseclp.fragments.security.StickerSection"
                type="XML"
            />
        </VBox>
    </HBox>
</core:FragmentDefinition>
