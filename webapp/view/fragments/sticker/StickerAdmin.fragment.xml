<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <!-- Sticker Management, admin view: organization-wide request counts and
         the status of the user's own requests. -->
    <f:Card id="_IDGenCard8"
        width="100%"
        binding="{dashboard>/sticker/admin}"
        class="jhahDataCard">
        <f:content>
            <VBox id="_IDGenVBox13" width="100%" renderType="Bare" class="jhahSection">

                <HBox id="_IDGenHBox13"
                    width="100%"
                    renderType="Bare"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="jhahKpiRow">
                    <HBox id="_IDGenHBox14" renderType="Bare" alignItems="Center">
                        <Title
                            id="title3"
                            text="{i18n>stickerTitle}"
                            level="H5"
                            class="jhahSectionTitle"/>
                    </HBox>
                    <!-- visible="{dashboard>/hasAdminSection}" -->
                    <SegmentedButton
                        id="viewModeToggleSA"
                        ariaLabelledBy="title"                        
                        visible="{dashboard>/sections/sticker/isAdmin}"
                        selectedKey="{dashboard>/sections/sticker/viewMode}"
                        selectionChange=".onViewModeChange($event, 'sticker')">
                        <items>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem4" key="admin" text="{i18n>viewModeAdmin}"/>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem5" key="employee" text="{i18n>viewModeEmployee}"/>
                        </items>
                    </SegmentedButton>
                </HBox>

                <core:Fragment
                    fragmentName="com.jhah.zhrjhahseclp.view.fragments.sticker.StickerKpis"
                    type="XML"/>

                <HBox id="_IDGenHBox15" class="jhahTwoColRow" renderType="Bare" alignItems="Stretch" width="100%">
                    <VBox id="_IDGenVBox14" class="jhahHalfCardWrap" renderType="Bare" width="100%">
                        <layoutData>
                            <FlexItemData id="_IDGenFlexItemData1" growFactor="1" baseSize="0%"/>
                        </layoutData>
                        <f:Card id="_IDGenCard9" class="jhahDataCard" width="100%">
                            <f:content>
                                <VBox id="_IDGenVBox15" class="jhahPairCardInner" renderType="Bare" justifyContent="Start" width="100%">
                                    <Title
                                        id="requestsTitle1"
                                        text="{i18n>stickerRequestsTitle}"
                                        level="H6"
                                        class="sapUiSmallMarginBottom"/>
                                    <Table
                                        id="requestsTable1"
                                        ariaLabelledBy="requestsTitle"
                                        items="{dashboard>/sticker/own/requests}"
                                        showSeparators="Inner"
                                        class="jhahInnerTable"
                                        fixedLayout="false"
                                        noDataText="{i18n>noData}">
                                        <columns>
                                            <Column id="_IDGenColumn"><Text id="_IDGenText7" text="{i18n>stickerRequestNumber}"/></Column>
                                            <Column id="_IDGenColumn1"><Text id="_IDGenText8" text="{i18n>stickerType}"/></Column>
                                            <Column id="_IDGenColumn2" hAlign="End"><Text id="_IDGenText9" text="{i18n>columnStatus}"/></Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem id="_IDGenColumnListItem">
                                                <cells>
                                                    <Link id="_IDGenLink" text="{dashboard>reqIdStr}" press=".onStickerRequestPress"/>
                                                    <Text id="_IDGenText10" text="{dashboard>type}"/>
                                                    <ObjectStatus id="_IDGenObjectStatus1" text="{dashboard>status}" state="{dashboard>statusState}"/>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </VBox>
                </HBox>

            </VBox>
        </f:content>
    </f:Card>

</core:FragmentDefinition>
