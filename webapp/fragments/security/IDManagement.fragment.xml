<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
>
    <VBox
        class="jhahSection"
        renderType="Bare"
        visible="{dashboard>/access/id}"
    >
        <Title text="ID Management System" level="H5" class="jhahSectionTitle" />
        <HBox class="jhahKpiRow" renderType="Bare" wrap="Wrap">
            <f:Card class="jhahKpiCard jhahAccentBlue jhahThirdCard jhahKpiCardIcon">
                <f:content>
                    <HBox class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://id-card" class="jhahKpiIcon jhahKpiIconBlue" />
                        <VBox class="jhahKpiTextCol" renderType="Bare">
                            <Label text="Total ID Request" class="jhahKpiTitle" />
                            <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                        </VBox>
                    </HBox>
                </f:content>
            </f:Card>
            <f:Card class="jhahKpiCard jhahAccentGreen jhahThirdCard jhahKpiCardIcon">
                <f:content>
                    <HBox class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://accept" class="jhahKpiIcon jhahKpiIconGreen" />
                        <VBox class="jhahKpiTextCol" renderType="Bare">
                            <Label text="Approved Cards" class="jhahKpiTitle" />
                            <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                        </VBox>
                    </HBox>
                </f:content>
            </f:Card>
            <f:Card class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">
                <f:content>
                    <HBox class="jhahKpiCardInner jhahKpiCardIconInner" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://pending" class="jhahKpiIcon jhahKpiIconOrange" />
                        <VBox class="jhahKpiTextCol" renderType="Bare">
                            <Label text="Pending Review" class="jhahKpiTitle" />
                            <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                        </VBox>
                    </HBox>
                </f:content>
            </f:Card>
        </HBox>
        <f:Card class="jhahDataCard">
            <f:content>
                <VBox class="sapUiSmallMargin" renderType="Bare" width="100%">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://id-card" class="jhahMutedText sapUiTinyMarginEnd" />
                        <Title text="ID Card Requests" level="H6" />
                    </HBox>
                    <Table class="jhahInnerTable" fixedLayout="false" noDataText="No data available">
                        <columns>
                            <Column><Text text="REQUEST ID" /></Column>
                            <Column><Text text="EMPLOYEE NAME" /></Column>
                            <Column><Text text="DEPARTMENT" /></Column>
                            <Column hAlign="End"><Text text="STATUS" /></Column>
                        </columns>
                    </Table>
                </VBox>
            </f:content>
        </f:Card>
    </VBox>
</core:FragmentDefinition>
