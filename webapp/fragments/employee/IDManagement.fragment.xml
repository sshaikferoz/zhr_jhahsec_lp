<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
>
    <VBox class="jhahSection" renderType="Bare">
        <Title text="ID Management System" level="H5" class="jhahSectionTitle" />
        <HBox class="jhahTwoColRow" renderType="Bare" alignItems="Stretch" width="100%">
            <!-- Badge ID card -->
            <VBox class="jhahHalfCardWrap" renderType="Bare" width="100%">
                <layoutData>
                    <FlexItemData growFactor="1" baseSize="0%" />
                </layoutData>
                <f:Card class="jhahDataCard" width="100%">
                    <f:content>
                        <VBox class="jhahPairCardInner" renderType="Bare" justifyContent="Start" width="100%">
                            <Label text="BADGE ID" class="jhahMutedText" />
                            <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                        </VBox>
                    </f:content>
                </f:Card>
            </VBox>
            <!-- In Progress Request card -->
            <VBox class="jhahHalfCardWrap" renderType="Bare" width="100%">
                <layoutData>
                    <FlexItemData growFactor="1" baseSize="0%" />
                </layoutData>
                <f:Card class="jhahDataCard" width="100%">
                    <f:content>
                        <VBox class="jhahPairCardInner" renderType="Bare" justifyContent="Start" width="100%">
                            <Label text="IN PROGRESS REQUEST" class="jhahMutedText" />
                            <Text text="No data available" class="jhahMutedText jhahNoDataValue" />
                        </VBox>
                    </f:content>
                </f:Card>
            </VBox>
        </HBox>
    </VBox>
</core:FragmentDefinition>
