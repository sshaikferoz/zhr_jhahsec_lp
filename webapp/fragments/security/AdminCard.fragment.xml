<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <VBox
        id="adminKpiSection"
        class="jhahSection"
        renderType="Bare">

        <Title
            id="adminKpiTitle"
            text="Admin Management"
            level="H5"
            class="jhahSectionTitle" />

        <HBox
            id="adminKpiRow"
            class="jhahKpiRow"
            renderType="Bare"
            wrap="Wrap">

            <!-- ============================================= -->
            <!-- TOTAL ID REQUESTS -->
            <!-- ============================================= -->

            <f:Card
                id="cardAdminTotalRequests"
                class="jhahKpiCard jhahAccentBlue jhahThirdCard jhahKpiCardIcon">

                <f:content>

                    <HBox
                        id="adminTotalRequestsInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="adminTotalRequestsIcon"
                            src="sap-icon://id-card"
                            class="jhahKpiIcon jhahKpiIconBlue" />

                        <VBox
                            id="adminTotalRequestsTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="adminTotalRequestsLabel"
                                text="Total ID Requests"
                                class="jhahKpiTitle" />

                            <Text
                                id="adminTotalRequestsValue"
                                text="{AdminKPI>/value/0/TotalIdRequests}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>

                </f:content>

            </f:Card>


            <!-- ============================================= -->
            <!-- PENDING REVIEW -->
            <!-- ============================================= -->

            <f:Card
                id="cardAdminPendingReview"
                class="jhahKpiCard jhahAccentOrange jhahThirdCard jhahKpiCardIcon">

                <f:content>

                    <HBox
                        id="adminPendingReviewInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="adminPendingReviewIcon"
                            src="sap-icon://pending"
                            class="jhahKpiIcon jhahKpiIconOrange" />

                        <VBox
                            id="adminPendingReviewTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="adminPendingReviewLabel"
                                text="Pending Review"
                                class="jhahKpiTitle" />

                            <Text
                                id="adminPendingReviewValue"
                                text="{AdminKPI>/value/0/PendingReview}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>

                </f:content>

            </f:Card>


            <!-- ============================================= -->
            <!-- APPROVED CARDS -->
            <!-- ============================================= -->

            <f:Card
                id="cardAdminApproved"
                class="jhahKpiCard jhahAccentGreen jhahThirdCard jhahKpiCardIcon">

                <f:content>

                    <HBox
                        id="adminApprovedInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="adminApprovedIcon"
                            src="sap-icon://accept"
                            class="jhahKpiIcon jhahKpiIconGreen" />

                        <VBox
                            id="adminApprovedTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="adminApprovedLabel"
                                text="Approved"
                                class="jhahKpiTitle" />

                            <Text
                                id="adminApprovedValue"
                                text="{AdminKPI>/value/0/ApprovedCards}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>

                </f:content>

            </f:Card>


            <!-- ============================================= -->
            <!-- REJECTED CARDS -->
            <!-- ============================================= -->

            <f:Card
                id="cardAdminRejected"
                class="jhahKpiCard jhahAccentRed jhahThirdCard jhahKpiCardIcon">

                <f:content>

                    <HBox
                        id="adminRejectedInner"
                        class="jhahKpiCardInner jhahKpiCardIconInner"
                        renderType="Bare"
                        alignItems="Center">

                        <core:Icon
                            id="adminRejectedIcon"
                            src="sap-icon://decline"
                            class="jhahKpiIcon jhahKpiIconRed" />

                        <VBox
                            id="adminRejectedTextCol"
                            class="jhahKpiTextCol"
                            renderType="Bare">

                            <Label
                                id="adminRejectedLabel"
                                text="Rejected"
                                class="jhahKpiTitle" />

                            <Text
                                id="adminRejectedValue"
                                text="{AdminKPI>/value/0/RejectedCards}"
                                class="jhahMutedText jhahNoDataValue" />

                        </VBox>

                    </HBox>

                </f:content>

            </f:Card>

        </HBox>

    </VBox>

</core:FragmentDefinition>